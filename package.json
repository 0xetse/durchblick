{
  "name": "durchblick",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Privacy-first Plattform, die zeigt, was digitale Dienste über dich erfassen – und was du tun kannst.",
  "license": "MIT",
  "engines": {
    "node": "^22.23.4 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:test": "astro build && node scripts/mark-test-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:engines": "PW_ENGINES=1 playwright test --project=firefox --project=webkit --project=iphone",
    "validate:content": "vitest run tests/content",
    "audit:deps": "node scripts/audit-deps.mjs",
    "verify": "npm run lint && npm run check && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.6",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.12",
    "preact": "11.2.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/preact": "3.2.6",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
