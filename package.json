{
  "name": "durchblick",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Privacy-first Plattform, die zeigt, was digitale Dienste über dich erfassen – und was du tun kannst.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:test": "astro build && node scripts/mark-test-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:engines": "PW_ENGINES=1 playwright test --project=firefox --project=webkit --project=iphone",
    "validate:content": "vitest run tests/content",
    "audit:deps": "npm audit --omit=dev --audit-level=moderate",
    "verify": "npm run lint && npm run check && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.6",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.7",
    "preact": "10.29.8",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/preact": "3.2.4",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
